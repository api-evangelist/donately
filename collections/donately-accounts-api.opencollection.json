{
  "opencollection": "1.0.0",
  "info": {
    "name": "Donately Accounts API",
    "version": "2019-03-15"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.donately.com/v2/accounts"
          },
          "docs": "Lists the accounts (organizations) the authenticated token can access. MODELED - verify against the live reference."
        },
        {
          "info": {
            "name": "Retrieve an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.donately.com/v2/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Retrieves a single account by ID. MODELED - verify against the live reference."
        }
      ]
    }
  ],
  "bundled": true
}