{
  "opencollection": "1.0.0",
  "info": {
    "name": "Donately Accounts Subscriptions API",
    "version": "2019-03-15"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.donately.com/v2/subscriptions",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "query",
                "description": "The ID of the account to operate against."
              }
            ]
          },
          "docs": "Returns recurring subscriptions for the specified account. CONFIRMED. Each subscription generates donations on its configured frequency."
        },
        {
          "info": {
            "name": "Retrieve a subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.donately.com/v2/subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Retrieves a single subscription by its unique identifier. CONFIRMED."
        },
        {
          "info": {
            "name": "Cancel a subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.donately.com/v2/subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Cancels a recurring subscription. MODELED - verify against the live reference."
        }
      ]
    }
  ],
  "bundled": true
}